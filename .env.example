# Copy this file to .env.local for local work. These are PUBLIC values (safe in the browser).
# NEVER put the service_role key, database password or any app password here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Cloudflare Turnstile SITE key (public). Leave empty to hide the human check.
VITE_TURNSTILE_SITE_KEY=
